  "cards": [
    {
      "dot": "cyan",
      "title": "Local control plane",
      "items": [
        "Web UI renders hub state and command actions from the Node server.",
        "The router reads the CSV registry and state file before each action."
      ]
    },
    {
      "dot": "emerald",
      "title": "Deployment flow",
      "items": [
        "The SSH layer connects to each remote hub, uploads athena.zip, and restarts the app.",
        "A health check confirms the remote Athena service is active before the status is saved."
      ]
    },
    {
      "dot": "rose",
      "title": "Operational data",
      "items": [
        "Each action writes logs and updates the persisted status file for the dashboard.",
        "The server supports deploy, update, perclos, vibration, and upload workflows."
      ]
    }
  ]
